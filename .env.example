# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Circle
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_ENTITY_SECRET=your-circle-entity-secret

# Public HTTPS URL Circle posts Gateway webhooks to. Must be reachable from the
# internet, so local dev needs a tunnel (e.g. ngrok) or a deployed URL. Used to
# create/sync the Gateway permissionless webhook subscription. If unset, the app
# falls back to `${NEXT_PUBLIC_APP_URL}/api/circle/webhook`; if neither is set,
# webhook registration is skipped (handler still works once events arrive).
WEBHOOK_ENDPOINT_URL=https://finch-aware-toucan.ngrok-free.app/api/circle/webhook

# Optional: dedicated endpoint for the Gateway *permissionless* webhook
# subscription. Circle requires a unique endpoint URL per subscription, so the
# Gateway subscription cannot reuse WEBHOOK_ENDPOINT_URL (used by the standard
# DCW subscription). If unset, it is derived by swapping the path of
# WEBHOOK_ENDPOINT_URL (or NEXT_PUBLIC_APP_URL) to `/api/circle/gateway-webhook`,
# which routes to the same handler. Set this only to override that default.
# GATEWAY_WEBHOOK_ENDPOINT_URL=

# Arc Testnet RPC (server-side only). Required for any Arc Testnet RPC reads
# (USDC balance lookups, etc.). Without it, requests fall back to the public
# RPC URL which is rate-limited.
ARC_TESTNET_RPC_KEY=

# Circle Kit Key (server-side). Shared by the Earn page (EarnKit), the Swap
# page (App Kit Swap) and the Add Funds dialog (Onramp Kit). When set, all
# three run in permissioned mode (integrator attribution + higher rate limits).
#
# Optional for Earn — it operates permissionlessly when this is blank. Required
# for Swap: the Stablecoin Service rejects an empty kit key, so the Swap page
# will not work without it.
#
# Get a free key from the Circle Console. Format: KIT_KEY:<keyId>:<keySecret>
KIT_KEY=

# Circle Onramp Kit. Uses KIT_KEY above — server-only, never expose to the client.
#
# The kit key must be the SANDBOX key: a key belongs to one environment, and the
# other rejects it. See the sandbox endpoints below.
#
# Settled purchases arrive as `onramp.deposit.settled` on the standard DCW
# subscription (WEBHOOK_ENDPOINT_URL above). That subscription is managed in the
# Circle Console, not by `npm run webhooks:register` — enable the notification
# type there or no onramp deposit is ever recorded.
#
# Sandbox endpoints. KEEP THESE SET. Unset, empty, or whitespace all mean the
# same thing to the onramp kit: use its production defaults, on mainnet, where
# every purchase charges a real payment method and cannot be reversed. Since
# this app only ever creates testnet wallets, a production session has nowhere
# valid to settle, so /api/onramp/session refuses to mint one — but do not rely
# on that refusal instead of setting these.
#
# Set BOTH together; they must always resolve to the same environment.
# NEXT_PUBLIC_* is inlined at build time, so restart `npm run dev` after a
# change here.
ONRAMP_API_BASE_URL=https://api-test.circle.com
NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io
